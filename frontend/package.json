{
  "name": "nys-imagery-search-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local NYS aerial imagery explorer and exact GeoRSCLIP search",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "package": "npm run build && electron-builder --win --dir",
    "test:ui": "node tests/verify-ui.mjs"
  },
  "dependencies": {"leaflet": "1.9.4"},
  "devDependencies": {"@types/leaflet": "1.9.21", "electron": "^38.0.0", "electron-builder": "^26.0.12", "typescript": "^5.9.2", "vite": "^7.1.7"},
  "build": {
    "appId": "local.nys.imagery.search",
    "productName": "NYS Imagery Search",
    "directories": {"output": "dist", "buildResources": "desktop"},
    "files": ["desktop/main.cjs", "package.json"],
    "extraResources": [{"from": "service", "to": "service", "filter": ["**/*.py"]}, {"from": "build", "to": "ui"}],
    "win": {"target": "dir", "signAndEditExecutable": false},
    "asar": true
  }
}
